{
  "name": "catbots",
  "description": "Catbots M0 macOS desktop foundation",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @catbots/desktop start",
    "dev:web": "pnpm --filter @catbots/desktop dev:web",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:release-node": "node scripts/check-release-node.mjs",
    "test:e2e": "pnpm check:release-node && pnpm --filter @catbots/desktop package && playwright test",
    "package": "pnpm check:release-node && pnpm --filter @catbots/desktop package",
    "make": "pnpm check:release-node && pnpm --filter @catbots/desktop make"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1"
  }
}
