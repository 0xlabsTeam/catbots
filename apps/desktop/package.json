{
  "name": "@catbots/desktop",
  "productName": "Catbots",
  "description": "Catbots M0 macOS desktop application",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node ../../scripts/package-desktop.mjs start",
    "dev:web": "vite --config vite.renderer.config.ts --open /web-preview.html",
    "package": "node ../../scripts/package-desktop.mjs package",
    "make": "node ../../scripts/package-desktop.mjs make && node ../../scripts/verify-package-contents.mjs out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@catbots/contracts": "workspace:*",
    "@catbots/execution-core": "workspace:*",
    "@catbots/strategy-runtime": "workspace:*",
    "@cloudflare/kumo": "^2.13.0",
    "@dagrejs/dagre": "^3.1.1",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.4",
    "@nktkas/hyperliquid": "0.33.3",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^12.6.2",
    "echarts": "^6.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "viem": "2.56.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
